# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Without these the app runs in DEMO MODE: all flows work against local mock
# data, no network calls, and the "View as" role switcher stays enabled.

# --- Firebase (Console → Project settings → Your apps → SDK setup) ---
# Public client identifiers, but kept in env so each environment points at its
# own Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firestore database id. Leave BLANK for the standard `(default)` database.
# Set this only if you created a *named* database — note that a database named
# "default" is NOT the `(default)` database, even though the console displays
# both the same way. Use the name from the console's database dropdown.
VITE_FIREBASE_DATABASE_ID=

# --- Stripe (Dashboard → Developers → API keys) ---
# Publishable key only. The SECRET key and webhook secret live in Firebase
# Functions secrets (see SETUP.md), never in this file.
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Feature flags ---
# Set to "false" to hide the top-bar "View as" role switcher in production.
VITE_ENABLE_ROLE_SWITCHER=

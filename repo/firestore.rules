rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role() { return me().role; }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isActive() { return signedIn() && me().status == 'active'; }
    function isVerifiedOrg() { return signedIn() && role() == 'org' && me().verified == true; }

    // ---- Users -------------------------------------------------------
    // Owner reads/writes their own profile; only admins (or Cloud Functions,
    // which bypass rules) can change verification, status, or report counts.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.status == 'active'
        && request.resource.data.reportCount == 0;
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.verified == resource.data.verified
            && request.resource.data.status == resource.data.status
            && request.resource.data.reportCount == resource.data.reportCount
            && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // ---- Listings ----------------------------------------------------
    // Org-priority listings are visible to verified orgs and admins; public
    // listings are visible to any signed-in user. Guests browse through a
    // Cloud Function / public mirror, never directly.
    match /listings/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.visibility == 'public')
        || (isVerifiedOrg() && resource.data.visibility == 'org')
        || (signedIn() && resource.data.donorUid == request.auth.uid);
      allow create: if isActive() && role() == 'donor'
        && request.resource.data.donorUid == request.auth.uid;
      allow update, delete: if isAdmin()
        || (isActive() && resource.data.donorUid == request.auth.uid);
    }

    match /recurringTemplates/{id} {
      allow read, write: if isAdmin()
        || (isActive() && request.resource.data.donorUid == request.auth.uid)
        || (isActive() && resource.data.donorUid == request.auth.uid);
    }

    // ---- Community requests (needs) ----------------------------------
    match /needs/{id} {
      allow read: if signedIn();
      allow create: if isActive() && role() == 'org'
        && request.resource.data.orgUid == request.auth.uid
        && request.resource.data.received == 0;
      // `received` is maintained by the onNeedContribution function only.
      allow update: if isAdmin()
        || (isActive() && resource.data.orgUid == request.auth.uid
            && request.resource.data.received == resource.data.received);
      allow delete: if isAdmin() || (isActive() && resource.data.orgUid == request.auth.uid);

      match /contributions/{cid} {
        allow read: if signedIn();
        allow create: if isActive() && request.resource.data.donorUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // ---- Orders / reservations ---------------------------------------
    // Payment status transitions come only from Cloud Functions.
    match /orders/{id} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.recipientUid == request.auth.uid
          || resource.data.donorUid == request.auth.uid
          || resource.data.driverUid == request.auth.uid
        ));
      allow create: if isActive()
        && request.resource.data.recipientUid == request.auth.uid
        && request.resource.data.status != 'paid';
      allow update: if isAdmin()
        || (isActive() && resource.data.recipientUid == request.auth.uid
            && request.resource.data.status == resource.data.status);
    }

    // ---- Deliveries (volunteer runs) ---------------------------------
    match /deliveries/{id} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.driverUid == request.auth.uid
          || resource.data.donorUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid
        ))
        || (isActive() && role() == 'driver' && resource.data.status == 'open');
      allow create: if isAdmin();
      // A driver claims an open run, or updates one already assigned to them.
      allow update: if isAdmin()
        || (isActive() && role() == 'driver'
            && (resource.data.driverUid == request.auth.uid
                || (resource.data.status == 'open'
                    && request.resource.data.driverUid == request.auth.uid)));
    }

    // ---- Messaging ----------------------------------------------------
    match /threads/{id} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if isActive() && request.auth.uid in request.resource.data.memberUids;

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(id)).data.memberUids;
        allow create: if isActive()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/threads/$(id)).data.memberUids;
        allow update, delete: if false;
      }
    }

    // ---- Trust & safety reports --------------------------------------
    // Anyone active can file; only admins can read or resolve.
    match /reports/{id} {
      allow create: if isActive() && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open';
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
